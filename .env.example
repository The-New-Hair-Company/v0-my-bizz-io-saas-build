# Public Supabase configuration (Project Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never expose this value in browser code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Clerk authentication. Create an application at dashboard.clerk.com, enable
# the native Supabase integration, then add the keys below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret

# Development-only convenience IDs. These are ignored in production.
ADMIN_CLERK_USER_IDS=user_your_admin_id
# Verified production addresses allowed to claim the first administrator. This
# is only a one-time bootstrap; persisted Clerk IDs authorize later sessions.
ADMIN_EMAILS=owner@example.com

# Optional services used by this app
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# Set these to absolute app.mybizz.io URLs in Vercel Production.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://localhost:3000/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=http://localhost:3000/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=http://localhost:3000/dashboard
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=generate_a_random_value_of_at_least_16_characters

# Stripe Billing. All are server-only; live values belong in Vercel Production.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDIO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_STUDIO_PAYMENT_LINK_URL=
STRIPE_SCALE_PAYMENT_LINK_URL=
STRIPE_STUDIO_PAYMENT_LINK_ID=
STRIPE_SCALE_PAYMENT_LINK_ID=
